# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zesxai
# Long random string (openssl rand -hex 32)
PAYLOAD_SECRET=change-me
# Optional: creates the first admin user when you run `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Public address of the site, used for canonical URLs and the sitemap (also settable in the CMS)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional lead notifications via Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
